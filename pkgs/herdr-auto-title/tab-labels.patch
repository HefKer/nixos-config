+	// maxLength is the bound inner was built with. The position is added on
+	// top of it, so a numbered title keeps the whole bound for its name.
 	maxLength int
 }
 
@@ -42,7 +41,8 @@ func (n *Numbered) Resolve(tab state.TabState) Decision {
 	// The prefix goes in front because truncation cuts the tail: a position at
 	// the end is the first thing a title too wide for the tab bar would lose.
