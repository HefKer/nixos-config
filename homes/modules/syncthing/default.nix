{
  config,
  lib,
  pkgs,
  osConfig,
  ...
}:
let
  table = import ./table.nix;
  ignores = import ./ignores.nix;
  home = config.home.homeDirectory;
  host = osConfig.networking.hostName;

  rows = lib.filterAttrs (_: row: lib.elem host row.peers) table.folders;
  peerNames = lib.unique (lib.concatMap (row: row.peers) (lib.attrValues rows));
  isAppState = row: row ? only;

  versioning =
    name: v:
    {
      inherit (v) type;
      fsPath = "${home}/.local/state/syncthing/versions/${name}";
    }
    // (
      if v.type == "staggered" then
        { params.maxAge = toString (v.maxAgeDays * 86400); }
      else
        { params.cleanoutDays = toString v.maxAgeDays; }
    );

  # "a/b/c" -> [ "a/b" "a" ]: each parent of a named path must itself be un-ignored, with its other children ignored.
  parents =
    path:
    let
      parts = lib.splitString "/" path;
    in
    lib.genList (i: lib.concatStringsSep "/" (lib.take (lib.length parts - 1 - i) parts)) (
      lib.length parts - 1
    );

  appStateLines =
    only:
    let
      dirs = lib.sort (a: b: lib.length (lib.splitString "/" a) > lib.length (lib.splitString "/" b)) (
        lib.unique (lib.concatMap parents only)
      );
    in
    map (p: "!/${p}") only
    ++ lib.concatMap (d: [
      "/${d}/*"
      "!/${d}"
    ]) dirs
    ++ [ "*" ];

  stignore =
    name: row:
    pkgs.writeText "stignore-${lib.strings.sanitizeDerivationName name}" (
      lib.concatLines (
        [ "// Generated by the nixos flake (ADR-0007); edits here are overwritten." ]
        ++ ignores.keyMaterial
        ++ (if isAppState row then appStateLines row.only else ignores.global ++ row.exclude or [ ])
      )
    );

  writeIgnore = name: row: ''
    stignore_install ${lib.escapeShellArg "${home}/${row.path}"} ${stignore name row}
  '';
in
{
  services.syncthing = {
    enable = true;
    cert = osConfig.sops.secrets.syncthing-cert.path;
    key = osConfig.sops.secrets.syncthing-key.path;
    overrideDevices = true;
    overrideFolders = true;

    settings = {
      devices = lib.genAttrs peerNames (
        name:
        let
          peer = table.peers.${name};
        in
        {
          inherit (peer) id;
          addresses =
            lib.optionals (peer ? address) [
              "tcp://${peer.address}:22000"
              "quic://${peer.address}:22000"
            ]
            ++ [ "dynamic" ];
        }
      );

      folders = lib.mapAttrs (
        name: row:
        {
          inherit (row) id;
          label = name;
          path = "${home}/${row.path}";
          devices = row.peers;
        }
        // lib.optionalAttrs (row ? versioning) { versioning = versioning name row.versioning; }
        // lib.optionalAttrs (row.ignorePerms or false) { ignorePerms = true; }
        // lib.optionalAttrs (isAppState row) { maxConflicts = 0; }
      ) rows;

      options.urAccepted = 3;
    };
  };

  # Before reloadSystemd, so a first start already has rules: ignorePatterns would land only after the first scan (ADR-0007).
  home.activation.syncthingIgnores = lib.hm.dag.entryBetween [ "reloadSystemd" ] [ "writeBoundary" ] (
    ''
      stignore_install() {
        run mkdir -p "$1"
        run install -m644 "$2" "$1/.stignore.nix-tmp"
        run mv -f "$1/.stignore.nix-tmp" "$1/.stignore"
      }
    ''
    + lib.concatStrings (lib.mapAttrsToList writeIgnore rows)
  );
}
