    "(?d).syncthing.*.tmp"

    "// Caches"
    "(?d).cache"
    "(?d).sass-cache"
    "(?d).thumbnails"

    "// Disk images: may be irreplaceable, never deletable"
    "*.iso"
    "*.dmg"
    "*.img"
  ];
