# Shared .stignore lists; first match wins, so the module puts keyMaterial ahead of everything (ADR-0007).
{
  # Never deletable: a remote directory delete must stop with an error, not take a key with it.
  keyMaterial = [
    ".env"
    ".env.local"
    ".env.*.local"
    "*.pem"
    "*.key"
    "*.p12"
    "*.pfx"
    "id_rsa*"
    "id_ed25519*"
    ".ssh"
    ".gnupg"
    ".netrc"
  ];

  # Every personal folder; (?d) marks what is regenerable, so a remote directory delete can clear it.
  global = [
    "// OS junk"
    "(?d).DS_Store"
    "(?d)._*"
    "(?d).Spotlight-V100"
    "(?d).Trashes"
    "(?d).fseventsd"
    "(?d).TemporaryItems"
    "(?d).AppleDouble"
    "(?d).LSOverride"
    "(?d)Thumbs.db"
    "(?d)Thumbs.db:encryptable"
    "(?d)ehthumbs.db"
    "(?d)ehthumbs_vista.db"
    "(?d)Desktop.ini"
    "(?d)$RECYCLE.BIN"
    "(?d).directory"
    "(?d).Trash-*"
    "(?d)*~"
    "(?d).nfs*"

    "// Editor state"
    "(?d).vs"
    "(?d)*.swp"
    "(?d)*.swo"
    "(?d)*.swn"
    "(?d).*.swp"
    "(?d).*.swo"
    "(?d).netrwhist"
    "(?d)*.sublime-workspace"
    "(?d)*.sublime-project"
    "(?d).history"
    "(?d).ionide"
    "(?d).metals"
    "(?d).bloop"
    "(?d).ensime_cache"
    "(?d)nbproject/private/"
    "(?d).vimrc.local"
    "(?d)Session.vim"

    "// Nix"
    "(?d).direnv"
    "(?d)result"

    "// Python"
    "(?d).venv"
    "(?d)venv"
    "(?d)env"
    "(?d)ENV"
    "(?d)__pycache__"
    "(?d)*.py[cod]"
    "(?d)*$py.class"
    "(?d)*.egg-info"
    "(?d).eggs"
    "(?d).pytest_cache"
    "(?d).mypy_cache"
    "(?d).ruff_cache"
    "(?d).tox"
    "(?d).nox"
    "(?d).coverage"
    "(?d).coverage.*"
    "(?d)htmlcov"
    "(?d).hypothesis"
    "(?d)pip-wheel-metadata"
    "(?d).python-version"
    "(?d)poetry.lock.bak"
    "(?d).ipynb_checkpoints"

    "// Node / JS"
    "(?d)node_modules"
    "(?d).npm"
    "(?d).yarn"
    "(?d).pnp.*"
    "(?d).pnpm-store"
    "(?d)bower_components"
    "(?d).next"
    "(?d).nuxt"
    "(?d).svelte-kit"
    "(?d).turbo"
    "(?d).parcel-cache"
    "(?d).vite"
    "(?d)dist"
    "(?d)out"

    "// Rust"
    "(?d)target"
    "(?d)Cargo.lock.bak"
    "(?d)**/*.rs.bk"

    "// Go"
    "(?d)vendor"
    "(?d)*.test"
    "(?d)*.out"

    "// Java / JVM"
    "(?d).gradle"
    "(?d)build"
    "(?d).mvn/wrapper/maven-wrapper.jar"
    "(?d)*.class"

    "// C / C++"
    "(?d)*.o"
    "(?d)*.obj"
    "(?d)*.so"
    "(?d)*.dylib"
    "(?d)*.dll"
    "(?d)*.a"
    "(?d)*.lib"
